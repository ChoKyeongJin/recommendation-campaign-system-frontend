# Server-only settings access. Do not use NEXT_PUBLIC_ names.
# Set the desired password in .env.local (development) or the deployment environment.
SETTINGS_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SETTINGS_SESSION_SECRET=
# Docker Compose can read the same file with: docker compose --env-file .env.local up -d
